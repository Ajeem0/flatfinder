# Copy this file to .env and fill in real values before running the server.

# Neon PostgreSQL connection string.
DATABASE_URL="postgresql://neondb_owner:npg_IiWB0LaEZ5Dx@ep-noisy-dream-ay8n0duc-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Any long random string. Used to sign login sessions (JWTs).
JWT_SECRET="change-me-to-a-secure-random-value"
JWT_EXPIRES_IN="7d"

PORT=4000

# Optional local Redis cache, for example: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Public base URL for processed local media, or your object-storage/CDN URL.
PUBLIC_MEDIA_URL="http://localhost:4000"

# Comma-free single origin the frontend runs on, e.g. http://localhost:5173
CORS_ORIGIN="http://localhost:5173"

# Google OAuth Web application Client ID used to verify Google ID tokens.
GOOGLE_CLIENT_ID="1065632607057-06hb80t0ua8109981ntj17ts7dgsopt0.apps.googleusercontent.com"

# MSG91 auth key used by the backend to verify the widget access token.
