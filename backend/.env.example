# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string. Example for a local Postgres install:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flatfinder"
DATABASE_URL="postgresql://username:password@localhost:5432/flatfinder?schema=public"

# Any long random string. Used to sign login sessions (JWTs).
JWT_SECRET="change-me-to-a-secure-random-value"
JWT_EXPIRES_IN="7d"

PORT=4000

# Comma-free single origin the frontend runs on, e.g. http://localhost:5173
CORS_ORIGIN="http://localhost:5173"
